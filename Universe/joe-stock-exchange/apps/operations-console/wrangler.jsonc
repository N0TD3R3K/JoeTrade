{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "joese-operations-console",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "stock-console.joe-univer.se",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"],
  },
  "main": "src/edge.ts",
  "services": [
    {
      "binding": "EXCHANGE_API",
      "service": "joese-exchange-api",
    },
  ],
}

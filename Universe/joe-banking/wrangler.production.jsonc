{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joe-banking",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/internal/joese/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_LOCAL_DEMO": "false",
    "APP_ORIGIN": "https://bank.joe-univer.se",
    "JOEAUTH_ISSUER": "https://auth.joe-univer.se",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joe-banking",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "database/migrations",
    },
  ],
  "routes": [
    {
      "pattern": "bank.joe-univer.se",
      "custom_domain": true,
    },
  ],
}

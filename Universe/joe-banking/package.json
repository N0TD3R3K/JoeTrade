{
  "name": "@joetrade/banking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "dev:test": "VITE_AUTO_DEMO=true vite --host 127.0.0.1 --port 4180 --strictPort",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply joe-banking-local --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute joe-banking-local --local --persist-to .wrangler/state --file database/seed/local-demo.sql"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.158.0"
  }
}

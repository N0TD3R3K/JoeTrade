{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joe-banking-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOW_LOCAL_DEMO": "true",
    "APP_ORIGIN": "http://127.0.0.1:4180",
    "JOEAUTH_ISSUER": "https://auth.joe-univer.se",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joe-banking-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "database/migrations",
    },
  ],
}
